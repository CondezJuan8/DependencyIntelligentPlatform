POSTGRES_DB=dependency_intelligence
POSTGRES_USER=dependency
POSTGRES_PASSWORD=local-development-only
POSTGRES_APP_PASSWORD=local-app-development-only
WEB_PORT=8088
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
AUTH_MAX_ATTEMPTS_PER_MINUTE=20
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@dependency.local
EMAIL_VERIFICATION_LIFETIME=PT24H
PASSWORD_RESET_LIFETIME=PT30M
ACCOUNT_MAIL_COOLDOWN=PT60S
PLATFORM_ADMISSION_DECISION_LIFETIME=PT24H
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_LOGIN_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ENABLED=false
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_CALLBACK_URL=http://localhost:8088/api/integrations/github/app-callback
GITHUB_APP_API_BASE_URL=https://api.github.com
OAUTH_AUTHORIZATION_LIFETIME=PT5M
OAUTH_REAUTHENTICATION_WINDOW=PT10M
INVITATION_LIFETIME=PT72H
OLLAMA_BASE_URL=http://ollama:11434
# Windows host model cache; Compose mounts this directory read-only into its private Ollama service.
OLLAMA_MODELS_HOST_PATH=${USERPROFILE}/.ollama/models
# Required by the assistant after verifying the local Ollama model and exact digest.
OLLAMA_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_REVISION=
# Gemini only receives authorized retrieved passages; keep the key outside source control.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_REQUEST_TIMEOUT=PT45S
