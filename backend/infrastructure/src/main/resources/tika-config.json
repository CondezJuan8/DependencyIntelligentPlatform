{
  "parsers": [
    { "default-parser": {} },
    {
      "pdf-parser": {
        "maxPages": 500,
        "maxMainMemoryBytes": 67108864,
        "pages": {
          "text": "AUTO",
          "ocr": { "maxPages": 50 }
        }
      }
    }
  ],
  "engines": {
    "tesseract": {
      "tesseract-ocr-parser": {
        "language": "eng+spa",
        "timeoutMillis": 15000
      }
    }
  },
  "text-recognizers": [
    { "engine": "tesseract" }
  ]
}
